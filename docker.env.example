# Copy to .env in the project root for Docker Compose:
#   copy docker.env.example .env
#
# Required
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars

# Optional — baked into the frontend image at build time
VITE_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX

# Optional — also create backend/.env for SMTP, Cloudinary, Razorpay secret, admin creds
# Docker Compose loads backend/.env automatically when that file exists.
